# Appended to /etc/zsh/zshrc by the add-on image. Keep it self-contained: the
# rest of that file (key bindings, sudo completion path) belongs to Debian.
#
# The prompt theme itself is loaded from ~/.zshrc by the block the add-on
# maintains there: sourcing it from this file would put it before the user's
# `compinit`, and powerlevel10k then never paints the first prompt.

if [[ -t 0 && -t 1 ]]; then
  # Debian only calls compinit on Ubuntu, so do it here to get completion.
  autoload -Uz compinit && compinit

  # HOME is /data/home, which is persistent: history survives add-on updates.
  HISTFILE=~/.zsh_history
  HISTSIZE=5000
  SAVEHIST=5000
  setopt HIST_IGNORE_ALL_DUPS SHARE_HISTORY
fi
